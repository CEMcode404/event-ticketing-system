# Copy to .env.local (gitignored) and fill in with real values from the
# Auth0 dashboard. Vite only exposes env vars prefixed with VITE_ to
# client code — that's a Vite requirement, not an Auth0 one.

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://event-ticketing-api